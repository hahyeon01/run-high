{
  "name": "@runhigh/web",
  "version": "0.1.0",
  "private": true,
  "description": "런하이 웹 앱 + Android(Capacitor) 앱",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:full": "VITE_API_URL=http://localhost:8787 vite",
    "build": "tsc -p tsconfig.json && vite build",
    "build:pages": "vite build --base=./",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "e2e": "playwright test",
    "cap:sync": "vite build && cap sync android",
    "cap:open": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/geolocation": "^8.2.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@fontsource-variable/urbanist": "^5.3.0",
    "@runhigh/core": "*",
    "@tanstack/react-query": "^5.104.3",
    "capacitor-health": "^8.4.0",
    "pretendard": "^1.3.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-iconly": "^2.2.10",
    "react-router": "^7.18.4",
    "sql.js": "^1.15.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@playwright/test": "1.56.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
