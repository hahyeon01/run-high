# 런하이 API 서버 환경 변수
PORT=8787
HOST=0.0.0.0
# 운영 환경에서는 반드시 길고 무작위한 값으로 설정하세요
JWT_SECRET=change-me-to-a-long-random-string
# 데이터(SQLite DB, 업로드 이미지) 저장 위치
DATA_DIR=./data
# 허용할 웹 출처 (쉼표로 구분). 비우면 모두 허용
CORS_ORIGINS=http://localhost:5173
# true면 DB가 비어 있을 때 데모 데이터를 넣고, 휴대폰 인증번호를 응답에 포함합니다 (운영에서는 false)
DEMO_MODE=true
# 빌드된 웹 앱 경로 (있으면 같은 서버에서 웹도 서빙)
# WEB_DIST=../web/dist
